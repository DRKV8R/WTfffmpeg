{
  "manifest_version": 3,
  "name": "WTfffmpeg - Local Video Creator",
  "version": "1.0.0",
  "description": "Create videos from images and audio files locally without Google Cloud",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WTfffmpeg Video Creator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}